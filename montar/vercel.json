{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/gabaritos",
      "destination": "https://malu-gabaritos.vercel.app/",
      "permanent": false
    },
    {
      "source": "/gabaritos/",
      "destination": "https://malu-gabaritos.vercel.app/",
      "permanent": false
    },
    {
      "source": "/gabaritos/:path*",
      "destination": "https://malu-gabaritos.vercel.app/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
